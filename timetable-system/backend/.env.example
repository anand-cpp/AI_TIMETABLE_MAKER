# Server Configuration
NODE_ENV=development
PORT=5000

# ─── Database ───────────────────────────────────────────────────────────────────
# LOCAL (default for development) — a mongod running on your machine:
MONGODB_URI=mongodb://127.0.0.1:27017/timetable_db

# ATLAS M0 (cloud / production on Render):
#   1. Create a free M0 cluster at https://cloud.mongodb.com
#   2. Database Access  -> add a user with readWrite to `timetable_db`
#   3. Network Access    -> allow your Render outbound IPs (or 0.0.0.0/0 to start)
#   4. Deployment -> Connect -> Drivers -> copy the SRV connection string
#   Replace <password>, <cluster>, and set the database name with `?retryWrites=true&w=majority`
#
# MONGODB_URI=mongodb+srv://<db_user>:<password>@<cluster>.mongodb.net/timetable_db?retryWrites=true&w=majority
#
# In production (NODE_ENV=production) the app REFUSES to start if MONGODB_URI is
# missing/unreachable — it will never silently fall back to localhost.
# Copy your existing local data into Atlas with:
#   node scripts/migrateToAtlas.js

# JWT Security Key (Replace with a strong random key in production — 32+ chars)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin(s) — comma-separated. Must match the exact frontend origin.
# localhost:      http://localhost:5173
# Render (web):   https://<your-backend>.onrender.com
# Render (static):https://<your-frontend>.onrender.com
CLIENT_URL=http://localhost:5175
